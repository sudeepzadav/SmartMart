generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD 
  QR
  CREDIT
}

enum CreditType {
  CHARGE  
  PAYMENT 
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

/* ---------- Existing models ---------- */

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?  @unique
  passwordHash String?
  pinHash      String?
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales     Sale[]
  purchases Purchase[]
  expenses  Expense[]
}

model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  stock       Int       @default(0)
  barcode     String?   @unique
  categoryId  String?   @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id])
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  costPrice  Float @default(0) 
  lowStockAt Int   @default(5) 
}

/* ---------- Sales ---------- */

// One line on a bill, stored inside the Sale document
type SaleItem {
  productId String @db.ObjectId
  name      String
  price     Float
  costPrice Float?
  quantity  Int
}

model Sale {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo     Int           @unique 
  cashierId     String        @db.ObjectId
  cashier       User          @relation(fields: [cashierId], references: [id])
  cashierName   String
  customerName  String? 
  customerId    String?       @db.ObjectId 
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  subtotal      Float         @default(0) 
  discount      Float         @default(0) 
  vat           Float         @default(0)
  total         Float 
  paymentMethod PaymentMethod
  amountPaid    Float 
  change        Float
  createdAt     DateTime      @default(now())

  @@index([createdAt])
}

/* ---------- Credit (udhar) ---------- */

model Customer {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String?
  balance   Float         @default(0) 
  active    Boolean       @default(true)
  sales     Sale[]
  entries   CreditEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// Ledger: every charge and repayment, so the balance can be checked
model CreditEntry {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  customerId String     @db.ObjectId
  customer   Customer   @relation(fields: [customerId], references: [id])
  type       CreditType
  amount     Float
  saleId     String?    @db.ObjectId
  note       String?
  createdAt  DateTime   @default(now())

  @@index([customerId, createdAt])
}

/* ---------- Suppliers and purchases ---------- */

model Supplier {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String?
  active    Boolean    @default(true)
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Purchase {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  orderNo      String         @unique            
  supplierName String
  status       String         @default("Pending") 
  orderDate    DateTime
  receivedAt   DateTime?
  total        Float
  note         String?
  items        PurchaseItem[]
  createdAt    DateTime       @default(now())
}

model PurchaseItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId String   @db.ObjectId
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  name       String  
  qty        Int
  unitCost   Float
  lineTotal  Float
}

/* ---------- Expenses ---------- */

model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String? 
  amount      Float
  note        String?
  date        DateTime @default(now())
  createdById String   @db.ObjectId
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}